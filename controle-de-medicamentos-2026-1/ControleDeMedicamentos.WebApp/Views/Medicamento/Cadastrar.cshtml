@model CadastrarMedicamentosViewModel;

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Cadastro de Medicamento";
}

<div class="row justify-content-start">
    <form class="col-lg-6" asp-action="Cadastrar" method="post">

        <div>
            <label class="form-label" asp-for="Nome"></label>
            <input class="form-control" asp-for="Nome" type="text">
        </div>

        <div class="mt-4">
            <label class="form-label" asp-for="Descricao"></label>
            <textarea class="form-control" asp-for="Descricao"></textarea>
        </div>

        <div class="mt-4">
            <label class="form-label" asp-for="FornecedorId">Fornecedor</label>
            <select class="form-select" asp-for="FornecedorId" asp-items="@ViewBag.Fornecedores"></select>
        </div>

        <div class="d-flex gap-3 mt-4">
            <button class="btn btn-primary" type="submit">
                <i class="bi bi-check"></i>
                Cadastrar
            </button>
            <a class="btn btn-outline-secondary" asp-action="Listar">
                <i class="bi bi-arrow-return-left"></i>
                Voltar para a lista
            </a>
        </div>
    </form>

    <form action="/Medicamento/Cadastrar" method="post">

        <div>
            <label for="nome">Nome</label>
            <br />
            <input id="nome" name="nome" type="text">
        </div>

        <div>
            <label for="descricao">Descrição</label>
            <br />
            <textarea id="descricao" name="descricao"></textarea>
        </div>

        <div>
            <label for="fornecedorId">Fornecedor</label>
            <br />
            <select id="fornecedorId" name="fornecedorId">
                @foreach (Fornecedor f in ViewBag.Fornecedores)
                {
                    <option value="@f.Id">@f.Nome</option>
                }
            </select>
        </div>

        <button type="submit">Cadastrar</button>
    </form>

    <p>
        <a href="/Medicamento/Listar">Voltar para a lista</a>
    </p>
