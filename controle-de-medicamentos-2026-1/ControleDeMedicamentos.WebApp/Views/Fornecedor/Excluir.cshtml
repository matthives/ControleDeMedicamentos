}

<div class="row justify-content-start">
    <form class="col-6" action="/Fornecedor/Excluir/@Model.Id" method="post">
        <div class=alert alert-danger mt-4" role="alert">
            " Você deseja realmente excluir o registro "@Model.Nome" ? Esta ação é irreversível. </p>
