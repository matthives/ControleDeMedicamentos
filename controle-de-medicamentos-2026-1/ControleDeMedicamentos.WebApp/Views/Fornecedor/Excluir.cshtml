@using ControleDeMedicamentos.WebApp.ModuloFornecedores

@model Fornecedor;

<h2>Controle de Medicamentos</h2>

<hr />
<a href="/">Início</a> / @* Âncora ou Link *@
<a href="/Fornecedor/Listar">Fornecedores</a> / @* Âncora ou Link *@
<hr />

<h1>Exclusão de Fornecedor</h1>

<form action="/Fornecedor/Excluir/@Model.Id" method="post">
    <p>
        Você deseja realmente excluir o registro "@Model.Nome"? Esta ação é irreversível.
    </p>

    <button type="submit">Confirmar</button>
</form>

<p>
    <a href="/Fornecedor/Listar">Voltar para a lista</a>
</p>
